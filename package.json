{
  "name": "doc2quiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS= node scripts/dev.mjs",
    "dev:clean": "cross-env NODE_OPTIONS= node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && npm run dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "example:serve": "npx --yes serve@14 example -l 5050",
    "eval-export-smoke": "node scripts/eval-export-smoke.mjs",
    "capture:dashboard": "node scripts/capture-dashboard.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "verify:phase7-callers": "node scripts/audit-phase7-route-callers.mjs",
    "verify:phase7-references": "node scripts/audit-phase7-route-references.mjs",
    "verify:phase7-routes": "npm run build && node scripts/verify-phase7-route-smoke.mjs",
    "verify:phase9-workspace": "node scripts/verify-phase9-workspace-bridge.mjs && vitest run src/lib/workspaces/legacyBridge.test.ts src/app/api/study-sets/[id]/route.test.ts src/app/api/study-sets/[id]/canonical/route.test.ts src/app/api/study-sets/[id]/ingest/route.test.ts src/app/api/study-sets/[id]/canonicalize/route.test.ts src/app/api/study-sets/[id]/quiz/generate/route.test.ts src/app/api/study-sets/[id]/flashcards/generate/route.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10.67.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@teispace/next-themes": "^2.0.4",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "playwright": "^1.52.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
