# Supabase Auth + Postgres (required for login and server-backed data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only text-to-MCQ generation (OpenAI-compatible /chat/completions)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Existing server-only flashcard, OCR, title, and embedding processing
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_MODEL_FREE=mineru25
AI_MODEL_PRO=gpt-4.1-mini

# Optional: upstream AI chat timeout in ms (default 300000 = 5 minutes)
# AI_REQUEST_TIMEOUT_MS=300000

DOC_PROCESSING_MODE=auto

# MarkItDown Python interpreter (project venv recommended for PDF support)
# Windows: .venv\Scripts\python.exe
# macOS/Linux: .venv/bin/python
# MARKITDOWN_PYTHON=
# Setup-only override when python/py on PATH is a Microsoft Store alias:
# MARKITDOWN_BOOTSTRAP_PYTHON=C:\Path\To\python.exe

# Optional: comma-separated Supabase user IDs that map to pro-tier processing
# AI_PRO_USER_IDS=
